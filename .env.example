# VulnReason Environment Configuration Template
PROJECT_NAME=VulnReason
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL or local SQLite for testing)
DATABASE_URL=sqlite+aiosqlite:///./vulnreason.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://vulnreason:vulnreason_secure_pass_2026@localhost:5432/vulnreason

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=vulnreason-super-secret-key-change-in-production-min32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Threat Intelligence APIs (Optional - Fallbacks provided)
NVD_API_KEY=
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
OSV_API_URL=https://api.osv.dev/v1

# AI Reasoning Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOCK_LLM_MODE=true
